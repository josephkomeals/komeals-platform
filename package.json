{
  "name": "komeals-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env test",
    "db:migrate:test": "wrangler d1 migrations apply DB --remote --env test",
    "db:migrate:live": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "deploy:test": "wrangler deploy --env test",
    "deploy:live": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
